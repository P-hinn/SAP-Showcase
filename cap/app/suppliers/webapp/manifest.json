{
  "_version": "1.59.0",
  "sap.app": {
    "id": "acme.procurement.suppliers",
    "type": "application",
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "dataSources": {
      "mainService": {
        "uri": "/procurement/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.fe.templates": {}
      }
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "acme.procurement.suppliers.i18n.i18n",
          "supportedLocales": [
            "",
            "de"
          ],
          "fallbackLocale": ""
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "routing": {
      "routes": [
        {
          "pattern": ":?query:",
          "name": "SuppliersList",
          "target": "SuppliersList"
        },
        {
          "pattern": "Suppliers({key}):?query:",
          "name": "SuppliersObjectPage",
          "target": "SuppliersObjectPage"
        }
      ],
      "targets": {
        "SuppliersList": {
          "type": "Component",
          "id": "SuppliersList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Suppliers",
              "variantManagement": "Page",
              "initialLoad": "Enabled",
              "navigation": {
                "Suppliers": {
                  "detail": {
                    "route": "SuppliersObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable",
                    "enableExport": true
                  },
                  "columns": {
                    "DataFieldForAnnotation::FieldGroup::Identity": {
                      "width": "15rem"
                    },
                    "DataField::country_code": {
                      "width": "9rem"
                    },
                    "DataField::financialRating_code": {
                      "width": "7rem"
                    },
                    "DataFieldForAnnotation::DataPoint::OnTimeDelivery": {
                      "width": "8rem"
                    },
                    "DataField::qualityIncidents12M": {
                      "width": "8rem"
                    },
                    "DataFieldForAnnotation::DataPoint::RiskScore": {
                      "width": "8rem"
                    },
                    "DataField::riskClass_code": {
                      "width": "9rem"
                    },
                    "DataField::isBlocked": {
                      "width": "8rem"
                    }
                  }
                }
              }
            }
          }
        },
        "SuppliersObjectPage": {
          "type": "Component",
          "id": "SuppliersObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "contextPath": "/Suppliers"
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  }
}
