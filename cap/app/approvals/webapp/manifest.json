{
  "_version": "1.59.0",
  "sap.app": {
    "id": "acme.procurement.approvals",
    "type": "application",
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "dataSources": {
      "mainService": {
        "uri": "/procurement/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.fe.templates": {}
      }
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "acme.procurement.approvals.i18n.i18n",
          "supportedLocales": [
            "",
            "de"
          ],
          "fallbackLocale": ""
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "routing": {
      "routes": [
        {
          "pattern": ":?query:",
          "name": "ApprovalsList",
          "target": "ApprovalsList"
        }
      ],
      "targets": {
        "ApprovalsList": {
          "type": "Component",
          "id": "ApprovalsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/MyApprovalTasks",
              "variantManagement": "Page",
              "initialLoad": "Enabled",
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable",
                    "selectionMode": "None",
                    "enableExport": true
                  },
                  "columns": {
                    "DataFieldWithUrl::title": {
                      "width": "16rem"
                    },
                    "DataField::requisitionNumber": {
                      "width": "9rem"
                    },
                    "DataField::requester": {
                      "width": "6rem"
                    },
                    "DataField::totalValue": {
                      "width": "9rem"
                    },
                    "DataField::supplierRiskClass_code": {
                      "width": "9rem"
                    },
                    "DataFieldForAnnotation::DataPoint::Progress": {
                      "width": "7rem"
                    },
                    "DataField::pendingApprovalLevel": {
                      "width": "6rem"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  }
}
