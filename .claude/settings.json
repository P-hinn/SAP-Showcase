{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run test:*)",
      "Bash(npm test:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run compile:check:*)",
      "Bash(npx cds compile:*)",
      "Bash(npm run build:*)",
      "Bash(npm run check:i18n:*)",
      "Bash(npm run screenshots:*)",
      "Bash(npm start:*)",
      "Bash(npm install:*)",
      "Bash(npm ls:*)",
      "Bash(node:*)",
      "Bash(curl:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(wc:*)",
      "Bash(du:*)",
      "Bash(find:*)",
      "Bash(gzip:*)",
      "Bash(rg:*)",
      "Read(//private/tmp/**)",
      "Write(//private/tmp/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/scripts/check-file-length.sh\"",
            "timeout": 10,
            "statusMessage": "Checking file length"
          }
        ]
      }
    ]
  }
}
